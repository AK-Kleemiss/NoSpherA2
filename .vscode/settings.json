{
    // Build/debug goes through the CMake Tools extension using the presets in
    // CMakePresets.json. Pick a configure preset in the status bar, build with
    // F7, pick a launch target (NoSpherA2 or NoSpherA2_Tests) and debug with
    // ctrl+F5. ctest runs through the Testing panel or the preset's test task.
    // NoSpherA2_Tests only exists under the "(+tests)" presets; the plain ones
    // configure with NOSPHERA2_BUILD_TESTS=OFF.
    "cmake.useCMakePresets": "always",
    // Run ctest with -j (number of CPUs) from the Testing panel; without this
    // it runs tests one by one. Output panel text may interleave.
    "cmake.ctest.allowParallelJobs": true,
    // Group the ~1270 gtests by suite in the Testing panel (Suite.Test names).
    "cmake.ctest.testSuiteDelimiter": "\\.",
    "cmake.ctest.testSuiteDelimiterMaxOccurrence": 1,
    "cmake.useVsDeveloperEnvironment": "always",
    // IntelliSense comes from the CMake configure, not a hand-kept
    // c_cpp_properties.json.
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.cppStandard": "c++20",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "terminal.integrated.scrollback": 100000,
    // A terminal for running cmake/ctest by hand on Windows, where Ninja needs
    // the MSVC environment. Adjust the Visual Studio path to your install.
    "terminal.integrated.profiles.windows": {
        "VS x64 Developer PowerShell": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "& { $vs = & \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -property installationPath; . \"$vs\\Common7\\Tools\\Launch-VsDevShell.ps1\" -Arch x64 -HostArch x64 -SkipAutomaticLocation; Set-Location \"${workspaceFolder}\" }"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "VS x64 Developer PowerShell"
}
