{
    // Both configurations debug whatever launch target is selected in the
    // CMake Tools status bar (NoSpherA2, NoSpherA2_Tests, ...), built from the
    // active preset. Put the arguments of the run you are chasing into "args"
    // and set "cwd" to the test directory the input files live in.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMake target (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "CMake target (Linux/macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "osx": {
                "MIMode": "lldb"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            // Example of a concrete debugging session: native NBO on the
            // epoxide fixture. Copy this block and swap args/cwd for others.
            "name": "Example: native NBO on epoxide (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-nbo_native", "epoxide.gbw", "-nrt", "-nbo_json", "epoxide-native.nbo.json"],
            "cwd": "${workspaceFolder}/tests/epoxide_gbw",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
