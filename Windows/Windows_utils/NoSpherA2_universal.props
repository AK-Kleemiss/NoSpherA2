<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <NosMainFolder>$(SolutionDir)..\..\</NosMainFolder>
    <WindowsUtilsDir>$(NosMainFolder)Windows\Windows_utils\</WindowsUtilsDir>
    <!-- ARM64 has no oneMKL: OpenBLAS from deps-install-*-arm64, vcomp as the OpenMP runtime -->
    <NosDepsSuffix Condition="'$(Platform)' == 'ARM64'">-arm64</NosDepsSuffix>
    <NosArchDefine Condition="'$(Platform)' == 'x64'">X64</NosArchDefine>
    <NosArchDefine Condition="'$(Platform)' == 'ARM64'">NSA2_OPENBLAS</NosArchDefine>
    <!-- ArmPL in place of OpenBLAS when the CMake dependency install found one and put it into
         deps-install-*-arm64\lib (NOSPHERA2_ARMPL). Release links the static armpl_lp64.lib, the
         /MD build, whose flang-built LAPACK needs the two runtimes installed next to it. Its objects
         refuse a /MDd link (LNK2038), so Debug links armpl_lp64.dll, copied by NoSpherA2_moveLibs -->
    <NosDepsLib Condition="'$(Configuration)' == 'Debug'">$(NosMainFolder)deps-install-debug$(NosDepsSuffix)\lib\</NosDepsLib>
    <NosDepsLib Condition="'$(Configuration)' != 'Debug'">$(NosMainFolder)deps-install-release$(NosDepsSuffix)\lib\</NosDepsLib>
    <NosArmPLLib>armpl_lp64.lib</NosArmPLLib>
    <NosArmPLLib Condition="'$(Configuration)' == 'Debug'">armpl_lp64.dll.lib</NosArmPLLib>
    <NosArmPL Condition="'$(Platform)' == 'ARM64' and Exists('$(NosDepsLib)$(NosArmPLLib)')">true</NosArmPL>
    <NosArchDefine Condition="'$(NosArmPL)' == 'true'">NSA2_OPENBLAS;NSA2_ARMPL</NosArchDefine>
    <NosBlasLibs Condition="'$(Platform)' == 'ARM64'">openblas.lib</NosBlasLibs>
    <NosBlasLibs Condition="'$(NosArmPL)' == 'true'">armpl_lp64.lib;flang_rt.runtime.dynamic.lib;clang_rt.builtins.lib</NosBlasLibs>
    <NosBlasLibs Condition="'$(NosArmPL)' == 'true' and '$(Configuration)' == 'Debug'">armpl_lp64.dll.lib</NosBlasLibs>
    <NosIgnoreLibs Condition="'$(Platform)' == 'ARM64'">LIBCMT</NosIgnoreLibs>
    <NosIgnoreLibs Condition="'$(Platform)' != 'ARM64'">VCOMPD.lib;VCOMP.lib;LIBCMT</NosIgnoreLibs>
  </PropertyGroup>
  <PropertyGroup>
    <PreBuildEventUseInBuild>false</PreBuildEventUseInBuild>
    <OutDir>$(NosMainFolder)build\$(Configuration)_$(Platform)\</OutDir>
    <IntDir>$(Configuration)_$(Platform)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <EnableParallelCodeGeneration>true</EnableParallelCodeGeneration>
      <FloatingPointModel>Fast</FloatingPointModel>
      <FloatingPointExceptions>false</FloatingPointExceptions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <SupportJustMyCode>false</SupportJustMyCode>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <AdditionalOptions>-openmp:experimental /utf-8 /wd4068 %(AdditionalOptions)</AdditionalOptions>
      <!-- occ is built without OpenMP and parallelises with TBB; its header templates instantiated here would otherwise
           run Eigen's OpenMP gemm inside every TBB worker. -->
      <PreprocessorDefinitions>%(PreprocessorDefinitions);EIGEN_DONT_PARALLELIZE</PreprocessorDefinitions>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <IgnoreSpecificDefaultLibraries>$(NosIgnoreLibs)</IgnoreSpecificDefaultLibraries>
    </Link>
    <Lib>
      <IgnoreSpecificDefaultLibraries>$(NosIgnoreLibs)</IgnoreSpecificDefaultLibraries>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>